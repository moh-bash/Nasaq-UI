exports[`defaultConfig generated CSS snapshots > Accordion.css 1`] = `
"/* Accordion.css
   Generated from the Component Playground configuration.
   Pairs with Accordion.jsx. Import both:
     import Accordion from './Accordion';
     import './Accordion.css';
   Colours reference the --color-* theme variables, with fallbacks.
*/

@import 'nasaq/styles.css';

@layer nasaq {
.nq-acc {
  --nq-acc-width: 100%;
  --nq-acc-max-width: 640px;
  --nq-acc-margin-inline: auto;
  --nq-acc-text-align: left;
  --nq-acc-font-family: system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
  --nq-acc-radius: 6px;
  --nq-acc-item-radius: 6px;
  --nq-acc-question-radius: 6px;
  --nq-acc-border-width: 1px;
  --nq-acc-border-style: solid;
  --nq-acc-shadow: none;
  --nq-acc-item-shadow: none;
  --nq-acc-bg: var(--color-surface, #ffffff);
  --nq-acc-border-color: var(--color-border, #d6d9d4);
  --nq-acc-duration: 280ms;
  --nq-acc-easing: cubic-bezier(0.2, 0, 0, 1);
  --nq-acc-icon-size: 18px;
  --nq-acc-item-gap: 0px;
  --nq-acc-divider-width: 1px;
  --nq-acc-divider-color: var(--color-border, #d6d9d4);
  --nq-acc-section-gap: 24px;
  --nq-acc-question-padding-y: 16px;
  --nq-acc-question-padding-x: 20px;
  --nq-acc-content-gap: 8px;
  --nq-acc-answer-padding: 16px;
  --nq-acc-heading-size: 26px;
  --nq-acc-heading-weight: 600;
  --nq-acc-heading-fg: var(--color-text, #14161a);
  --nq-acc-question-fg: var(--color-text, #14161a);
  --nq-acc-question-size: 16px;
  --nq-acc-question-weight: 500;
  --nq-acc-answer-fg: var(--color-text-muted, #5c635e);
  --nq-acc-answer-size: 15px;
  --nq-acc-line-height: 1.55;
  --nq-acc-letter-spacing: 0em;
  --nq-acc-question-bg: var(--color-surface, #ffffff);
  --nq-acc-answer-bg: var(--color-background, #edefec);
  --nq-acc-hover-bg: var(--color-hover, #f1f3ef);
  --nq-acc-open-bg: var(--color-active, #ecf0ff);
  --nq-acc-icon-color: var(--color-primary, #1e3ae0);
  --nq-acc-focus-color: var(--color-focus, #1e3ae0);
  --nq-acc-answer-border-top-width: 0px;
  --nq-acc-answer-border-block-width: 0px;
}
}"
`;

exports[`defaultConfig generated CSS snapshots > Button.css 1`] = `
"/* Button.css
   Generated from the Component Playground configuration.
   Pairs with Button.jsx. Import both:
     import Button from './Button';
     import './Button.css';

   Structural rules come from nasaq/styles.css; this file only overrides
   the documented --nq-btn-* variables.
*/

@import 'nasaq/styles.css';

@layer nasaq {
.nq-btn {
  --nq-btn-radius: 10px;
  --nq-btn-gap: 8px;
  --nq-btn-font-family: system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
  --nq-btn-font-weight: 600;
  --nq-btn-letter-spacing: 0em;
  --nq-btn-icon-size: 18px;
  --nq-btn-border-width: 1px;
  --nq-btn-border-style: solid;
  --nq-btn-shadow: none;
  --nq-btn-duration: 160ms;
  --nq-btn-easing: ease;
  --nq-btn-padding-y: 10px;
  --nq-btn-padding-x: 18px;
  --nq-btn-font-size: 15px;
  --nq-btn-min-height: 40px;
}

.nq-btn--primary {
  --nq-btn-bg: var(--color-primary, #1e3ae0);
  --nq-btn-fg: var(--color-on-primary, #ffffff);
  --nq-btn-border-color: var(--color-primary, #1e3ae0);
  --nq-btn-bg-hover: color-mix(in srgb, var(--color-primary, #1e3ae0) 88%, #000);
}

.nq-btn--secondary {
  --nq-btn-bg: var(--color-secondary, #0e4f45);
  --nq-btn-fg: var(--color-on-secondary, #ffffff);
  --nq-btn-border-color: var(--color-secondary, #0e4f45);
  --nq-btn-bg-hover: color-mix(in srgb, var(--color-secondary, #0e4f45) 88%, #000);
}

.nq-btn--outline {
  --nq-btn-bg: transparent;
  --nq-btn-fg: var(--color-text, #14161a);
  --nq-btn-border-color: var(--color-border, #d6d9d4);
  --nq-btn-bg-hover: var(--color-hover, #f1f3ef);
}

.nq-btn--ghost {
  --nq-btn-bg: transparent;
  --nq-btn-fg: var(--color-text, #14161a);
  --nq-btn-border-color: transparent;
  --nq-btn-bg-hover: var(--color-hover, #f1f3ef);
}

.nq-btn--danger {
  --nq-btn-bg: var(--color-danger, #c42b1c);
  --nq-btn-fg: var(--color-on-danger, #ffffff);
  --nq-btn-border-color: var(--color-danger, #c42b1c);
  --nq-btn-bg-hover: color-mix(in srgb, var(--color-danger, #c42b1c) 88%, #000);
}

}"
`;

exports[`defaultConfig generated CSS snapshots > Tabs.css 1`] = `
"/* Tabs.css — generated by Nasaq UI. Pairs with Tabs.jsx.
   Structural rules come from nasaq/styles.css. */

@import 'nasaq/styles.css';

@layer nasaq {
.nq-tabs {
  --nq-tabs-active: var(--color-primary, #1e3ae0);
  --nq-tabs-text: var(--color-text, #14161a);
  --nq-tabs-muted: var(--color-text-muted, #5c635e);
  --nq-tabs-border: var(--color-border, #d6d9d4);
  --nq-tabs-panel: var(--color-surface, #ffffff);
  --nq-tabs-gap: 24px;
  --nq-tabs-radius: 10px;
  --nq-tabs-duration: 160ms;
  --nq-tabs-easing: ease-out;
}
}"
`;
