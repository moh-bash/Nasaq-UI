{
  "name": "nasaq-ui-monorepo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @nasaq-ui/docs",
    "dev:docs": "npm run dev -w @nasaq-ui/docs",
    "build": "npm run build -w nasaq && npm run build -w @nasaq-ui/docs",
    "build:lib": "npm run build -w nasaq",
    "build:docs": "npm run build -w @nasaq-ui/docs",
    "preview": "npm run preview -w @nasaq-ui/docs",
    "test": "npm run test -w nasaq && npm run test -w @nasaq-ui/docs",
    "test:watch": "npm run test:watch -w @nasaq-ui/docs",
    "lint": "npm run lint -w @nasaq-ui/docs && npm run lint -w nasaq",
    "check": "npm run check -w nasaq",
    "coverage": "npm run coverage -w @nasaq-ui/docs",
    "e2e": "npm run build && playwright test",
    "e2e:update": "npm run build && playwright test --update-snapshots",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@playwright/test": "^1.64.1",
    "vitest-axe": "^0.1.0"
  }
}
